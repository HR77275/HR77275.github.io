# Optional: set an explicit trusted HTTPS origin when using a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Vercel automatically supplies VERCEL_PROJECT_PRODUCTION_URL otherwise.
# Do not copy the private Sites preview URL into Vercel environment settings.

# Optional runtime override for the existing private Sites preview.
# SITE_URL=https://your-deployed-site.example